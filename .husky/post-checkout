# >>> justin-sdk:worktree-hydration >>> MANAGED BLOCK — regenerated by `bun run justin-sdk add husky`. Edit the SDK template, not this copy.
# Auto-hydrate a FRESH WORKTREE (home-base-v170.12). `git worktree add` fires
# post-checkout with cwd = the NEW tree (verified empirically), and that tree
# holds only what git TRACKS: no node_modules, no populated submodules, no
# generated version files. So it is neither buildable nor lintable, and the
# errors it produces name the WRONG cause. Hydrating here pays that cost once,
# at creation, instead of as a confusing failure later. One wiring covers every
# worktree-creation path — `claude --worktree`, subagent isolation:worktree,
# background sessions, `wt -n`, manual `git worktree add` — because they all go
# through real git, and a linked worktree shares the primary's .git/config (so
# husky's core.hooksPath is already set there).
# NOT a fresh CLONE, and it cannot be: `core.hooksPath` is local config that is
# never cloned, and `.git/hooks` in a clone holds only samples — so NO
# repo-committed hook runs during `git clone`. Hooks start working only after
# the install that `prepare` wires them from, which is the very thing this hook
# would have done. A fresh clone still needs one manual `bun install`.
# The node_modules guard keeps ordinary branch switches free.
[ -d node_modules ] || {
  echo "[post-checkout] Fresh checkout detected — hydrating with justin-sdk setup-env..."
  # Resolve the SDK STATIC-SAFELY (epic home-base-v170 D1, epic home-base-dchjw
  # D1): this tree has no node_modules, so a project-local `bun run justin-sdk`
  # cannot resolve HERE. The MAIN worktree's installed binary can — it is
  # offline, and it honors the project's own SDK pin — so that is the one and
  # only path that hydrates.
  # THERE IS NO bunx FALLBACK any more. It used to run
  # `bunx github:justinhaaheim/justin-sdk setup-env`, which is an UNPINNED
  # spec: bunx caches a github spec by spec STRING, so that line silently ran
  # whatever commit it first fetched, forever, on a hook nobody watches — and it
  # reached the network from `git worktree add`. A tree that cannot be hydrated
  # from the main checkout now says so and skips, which is a visible, fixable
  # state rather than a quiet one.
  # Caveat, benign: inside a git SUBMODULE, git reports the main worktree as the
  # `.git/modules/<path>` gitdir, which has no node_modules — so that case now
  # takes the skip branch.
  _jsdk_main=$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p') || _jsdk_main=''
  _jsdk_warn="WARNING: [post-checkout] justin-sdk setup-env failed (non-fatal) — this tree is NOT hydrated. Run: bun install"
  # NON-FATAL BY CONSTRUCTION: a non-zero post-checkout makes `git worktree add`
  # itself exit non-zero (verified), so an offline or broken hydrate must never
  # propagate — every path below ends in a command that succeeds. This also has
  # to survive husky's `sh -e` (errexit), hence `||` on every fallible command.
  # No flags at all: the v170 tier system (--lint/--js/--native) is gone, and
  # `setup-env` runs every `setup-env:<LABEL>` script the project declares. A
  # project that must NOT pay a slow step on every worktree creation (minutes of
  # CocoaPods latency, say) keeps it out of those scripts.
  if [ -n "$_jsdk_main" ] && [ -x "$_jsdk_main/node_modules/.bin/justin-sdk" ]; then
    "$_jsdk_main/node_modules/.bin/justin-sdk" setup-env || echo "$_jsdk_warn"
  else
    echo "[post-checkout] SKIPPED hydration: justin-sdk is not installed in the main checkout (${_jsdk_main:-unknown}) — run \`bun install\` there, then \`bun run justin-sdk setup-env\` here. This tree is NOT hydrated."
  fi
  unset _jsdk_main _jsdk_warn
}
# <<< justin-sdk:worktree-hydration <<<
